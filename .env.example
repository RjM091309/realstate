# Copy to `.env` in this folder (`cp .env.example .env`) and edit values.
# Without `.env`, the API falls back to MySQL user `root` with an empty password
# (usually denied on Linux) and may bind API_PORT to a value that conflicts.
#
# Create the DB user in MySQL if needed, then grant access to DATABASE_NAME:
#   CREATE USER IF NOT EXISTS '3core'@'localhost' IDENTIFIED BY 'your_password';
#   GRANT ALL ON realstate.* TO '3core'@'localhost';
#   FLUSH PRIVILEGES;
# Import schema: mysql -u 3core -p realstate < database/realstate_init.sql
# (or let ensureSchema run on first API start once credentials work.)

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=3core
DATABASE_PASSWORD=2024.3core21
DATABASE_NAME=realstate

# API (Express). Vite dev server (default port 2551) proxies /api here — keep API_PORT in sync.
API_PORT=2550

# JWT signing (min 16 chars). Change for production.
JWT_SECRET=realstate-change-this-secret-key-32chars

# Dev only: allow the UI to call protected APIs without JWT (via x-dev-user-id header).
# Never enable in production.
ALLOW_BYPASS_AUTH=true

# Optional: Gemini (existing app)
GEMINI_API_KEY=
